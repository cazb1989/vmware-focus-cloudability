# /etc/vmware-focus/env  (permisos 640, dueño root:vmwarefocus). NO versionar este archivo con valores reales.
# vCenter (uno o varios, separados por espacio). Usuario de SOLO LECTURA.
VCENTER_HOSTS="vcenter01.empresa.local vcenter02.empresa.local"
VCENTER_USER="cloudability-ro@vsphere.local"
VCENTER_PASSWORD="cambiar"
# CA de vCenter: descargar de https://<vcenter>/certs/download.zip ("false" solo para pruebas)
VCENTER_CA_BUNDLE="/etc/vmware-focus/vcenter-ca.pem"
# Leer también etiquetas de vSphere (además de los atributos personalizados). Vacío = no.
INCLUDE_TAGS=""

# Destino en AWS (usuario IAM vmware-inventory-uploader: solo puede subir al inbox)
S3_BUCKET="mi-bucket-focus"
INBOX_PREFIX="vmware-inbox"
AWS_ACCESS_KEY_ID="AKIA..."
AWS_SECRET_ACCESS_KEY="cambiar"
AWS_DEFAULT_REGION="us-east-1"

# Opcionales
UPLOAD_SPACING_SECONDS=60
KEEP_DAYS=30
